/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    ListNode* reverseList(ListNode* head) {
        // prev指向已经反转完成的部分
        ListNode* prev = NULL;

        // cur指向当前准备处理的节点
        ListNode* cur = head;

        // 只要当前还有节点，就继续处理
        while (cur != NULL) {
            // 第一步：保存下一个节点
            ListNode* nextNode = cur->next;

            // 第二步：把当前节点的箭头反过来
            cur->next = prev;

            // 第三步：prev移动到当前节点
            prev = cur;

            // 第四步：cur移动到下一个节点
            cur = nextNode;
        }

        // prev指向反转后的新头节点
        return prev;
    }
};
